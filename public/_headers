# Headers that Cloudflare sends with every file of the site. The CSP only
# reports for now (in the browser console): it becomes enforcing once the first
# deploy shows no violations. connect-src follows VITE_API_URL in .env.production
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.consertiva.com.br; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
