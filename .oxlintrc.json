{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zod",
            "message": "Import z from @/lib/zod, which turns off zod's new Function before any schema is created."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/zod.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      // Playwright's fixtures hand out a use() that is not React's, and read
      // what a fixture needs from the pattern of its first parameter, even
      // when it needs nothing: ({}, use)
      "files": ["e2e/**"],
      "rules": {
        "react/rules-of-hooks": "off",
        "no-empty-pattern": "off"
      }
    }
  ]
}
