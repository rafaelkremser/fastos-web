# Valores do `npm run dev`. Para mudar só na sua máquina, coloque os valores
# novos em .env.development.local, que o git ignora.

# Onde a API roda.
VITE_API_URL=http://localhost:3333

# Domínio de onde saem os subdomínios das lojas, sem a porta. A loja "loja-a"
# abre em loja-a.localhost:5173; o navegador manda qualquer *.localhost para
# este computador, então não há nada para configurar.
VITE_APP_HOST=localhost
