# Valores do npm run build, que vai para o Cloudflare (npm run deploy). Não
# guardam segredo nenhum: tudo aqui acaba no código que o navegador baixa.

# Onde a API roda, no Fly.io. Se mudar, mude também o connect-src do
# public/_headers.
VITE_API_URL=https://api.consertiva.com.br

# A loja "loja-a" abre em loja-a.consertiva.com.br.
VITE_APP_HOST=consertiva.com.br
